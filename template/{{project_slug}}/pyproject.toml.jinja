[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ python_version }}"
readme = "README.md"
dependencies = [
    "django>=5.0,<6.0",
    "django-environ>=0.11",
{%- if use_drf %}
    "djangorestframework>=3.15",
{%- endif %}
{%- if use_simplejwt %}
    "djangorestframework-simplejwt>=5.3",
{%- endif %}
{%- if use_openapi %}
    "drf-spectacular>=0.27",
{%- endif %}
{%- if database == "postgresql" %}
    "psycopg[binary]>=3.1",
{%- elif database == "mysql" %}
    "mysqlclient>=2.2",
{%- endif %}
{%- if use_celery %}
    "celery>=5.3",
    "django-celery-results>=2.5",
    "redis>=5.0",
{%- endif %}
{%- if use_docker %}
    "gunicorn>=22.0",
{%- endif %}
]

[dependency-groups]
dev = [
    "ruff>=0.6",
{%- if use_tests %}
    "pytest>=8.0",
    "pytest-django>=4.8",
    "pytest-cov>=5.0",
    "factory-boy>=3.3",
{%- endif %}
{%- if use_semantic_release %}
    "python-semantic-release>=9.8",
{%- endif %}
{%- if use_pre_commit %}
    "pre-commit>=3.8",
{%- endif %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["config", "apps"]

{% if use_tests -%}
[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "config.settings.local"
python_files = ["test_*.py", "*_test.py"]
testpaths = ["tests", "apps"]
addopts = "--reuse-db"

{% endif -%}
[tool.ruff]
line-length = 100
target-version = "py{{ python_version.replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "DJ"]

{% if use_semantic_release -%}
[tool.semantic_release]
version_variables = ["pyproject.toml:project.version"]
branch = "main"
build_command = "uv build"
commit_parser = "conventional"

[tool.semantic_release.changelog]
exclude_commit_patterns = []
{% endif -%}
