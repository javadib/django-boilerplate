FROM python:{{ python_version }}-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

{%- if database == "mysql" %}
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential default-libmysqlclient-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
{%- endif %}

COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-install-project --no-dev --no-editable || uv sync --no-install-project --no-dev

COPY . .
RUN uv sync --frozen --no-dev --no-editable || uv sync --no-dev

FROM python:{{ python_version }}-slim AS final

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

{%- if database == "mysql" %}
# Runtime-only client library for the mysqlclient wheel built in `builder`;
# no compilers or dev headers land in the final image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmariadb3 \
    && rm -rf /var/lib/apt/lists/*
{%- endif %}

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app /app

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000"]
