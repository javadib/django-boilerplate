services:
  web:
    build:
      context: .
      dockerfile: docker/Dockerfile
    command: python manage.py runserver 0.0.0.0:8000
    volumes:
      - .:/app
      # Named volume so the venv built inside the image isn't shadowed by
      # the bind mount above (which doesn't exist on the host).
      - venv_data:/app/.venv
    ports:
      - "8000:8000"
    env_file:
      - .env
{%- if database in ("postgresql", "mysql") or use_celery %}
    depends_on:
{%- if database in ("postgresql", "mysql") %}
      - db
{%- endif %}
{%- if use_celery %}
      - redis
{%- endif %}
{%- endif %}
{% if database == "postgresql" %}
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: {{ project_slug }}
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    volumes:
      - postgres_data:/var/lib/postgresql/data
{% endif -%}
{% if database == "mysql" %}
  db:
    image: mysql:8
    environment:
      MYSQL_DATABASE: {{ project_slug }}
      MYSQL_ROOT_PASSWORD: root
    volumes:
      - mysql_data:/var/lib/mysql
{% endif -%}
{% if use_celery %}
  redis:
    image: redis:7-alpine

  worker:
    build:
      context: .
      dockerfile: docker/Dockerfile
    command: celery -A config worker -l info
    volumes:
      - .:/app
      - venv_data:/app/.venv
    env_file:
      - .env
    depends_on:
      - redis
{% endif -%}
volumes:
  venv_data:
{%- if database == "postgresql" %}
  postgres_data:
{%- endif %}
{%- if database == "mysql" %}
  mysql_data:
{%- endif %}
