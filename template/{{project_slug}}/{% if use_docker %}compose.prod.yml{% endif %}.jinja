services:
  web:
    build:
      context: .
      dockerfile: docker/Dockerfile
      target: final
    ports:
      - "8000:8000"
    env_file:
      - .env
{%- if database in ("postgresql", "mysql") or use_celery %}
    depends_on:
{%- if database in ("postgresql", "mysql") %}
      - db
{%- endif %}
{%- if use_celery %}
      - redis
{%- endif %}
{%- endif %}
{% if database == "postgresql" %}
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: {{ project_slug }}
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    volumes:
      - postgres_data:/var/lib/postgresql/data
{% endif -%}
{% if database == "mysql" %}
  db:
    image: mysql:8
    environment:
      MYSQL_DATABASE: {{ project_slug }}
      MYSQL_ROOT_PASSWORD: root
    volumes:
      - mysql_data:/var/lib/mysql
{% endif -%}
{% if use_celery %}
  redis:
    image: redis:7-alpine

  worker:
    build:
      context: .
      dockerfile: docker/Dockerfile
      target: final
    command: celery -A config worker -l info
    env_file:
      - .env
    depends_on:
      - redis
{% endif -%}
{%- if database == "postgresql" %}
volumes:
  postgres_data:
{%- elif database == "mysql" %}
volumes:
  mysql_data:
{%- endif %}
